# Runtime smoke image; test messages and the compiler are deliberately absent.
ARG BASE_IMAGE=ros:humble-ros-base
FROM ${BASE_IMAGE}
ARG ROS_DISTRO=humble
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rosbag2-storage-mcap ros-${ROS_DISTRO}-rmw-fastrtps-cpp
COPY ros2_bag /opt/ros2_bag
ENV ROS_LOG_DIR=/tmp/ros2-bag-logs
ENTRYPOINT ["/opt/ros2_bag/ros2_bag", "recorder"]
CMD ["--phase0-info"]
