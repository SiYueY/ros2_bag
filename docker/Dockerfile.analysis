# AC-55 isolation: only a loader harness is copied, never generated ROS fixtures.
ARG BASE_IMAGE=ros:humble-ros-base
FROM ${BASE_IMAGE}
ARG ROS_DISTRO=humble
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential pkg-config qtbase5-dev libqt5svg5-dev ros-${ROS_DISTRO}-plotjuggler
COPY tests/probes/plotjuggler_probe.cpp tests/support/check.hpp /analysis/src/
COPY tools/verify-clean-analysis-env.sh /analysis/verify-clean-analysis-env.sh
RUN c++ -std=c++17 -fPIC /analysis/src/plotjuggler_probe.cpp -I/analysis/src \
    -I/opt/ros/${ROS_DISTRO}/include $(pkg-config --cflags --libs Qt5Widgets Qt5Xml) \
    -L/opt/ros/${ROS_DISTRO}/lib -Wl,-rpath,/opt/ros/${ROS_DISTRO}/lib \
    -lplotjuggler_base -o /analysis/phase0_plotjuggler_probe
ENV QT_QPA_PLATFORM=offscreen
ENTRYPOINT []
WORKDIR /analysis
CMD ["bash", "-lc", "source /opt/ros/$ROS_DISTRO/setup.bash && bash /analysis/verify-clean-analysis-env.sh"]
